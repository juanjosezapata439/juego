classDiagram
    direction TB
    class Game {
        -_process(delta)
        -_unhandled_input(event)
        -_draw()
    }
    class StateMachine {
        +current: GameState
        +add(name, state)
        +change(name, params)
        +get_state(name) GameState
    }
    class GameState {
        <<abstract>>
        #game: Game
        +enter(params)
        +exit()
        +handle_input(actions)
        +update(delta)
        +draw(ui)
        +timer_runs() bool
    }
