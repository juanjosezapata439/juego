classDiagram
    direction TB
    class RoomBuilder {
        <<abstract Creator>>
        +build(data, index) Room
        +create_rules(data)* RoomRules
        +create_tile(symbol, cell, data) Tile
        +decorate(room, data)
        +layout_origin(room) Vector2
    }
    class ClockRoomBuilder {
        +create_rules(data) RoomRules
        +create_tile(symbol, cell, data) Tile
    }
    class SumRoomBuilder {
        +create_rules(data) RoomRules
        +create_tile(symbol, cell, data) Tile
    }
    class MinesRoomBuilder {
        +create_rules(data) RoomRules
        +create_tile(symbol, cell, data) Tile
    }
    class TownBuilder {
        +create_rules(data) RoomRules
        +create_tile(symbol, cell, data) Tile
        +decorate(room, data)
    }
    class RoomBuilderRegistry {
        +register(kind, builder)
        +build(data, index) Room
    }
    class Tile {
        <<abstract Product>>
        +is_solid(room) bool
        +on_enter(ctx)
        +on_interact(ctx)
        +draw(ui, at, room)
    }
    class WallTile
    class FloorTile
